--========================================================

minus.Activated:Connect(function()

	FLY_SPEED = math.max(10,FLY_SPEED - 10)

	speedLabel.Text = "FLY SPEED     "..FLY_SPEED

	local percent = math.clamp(FLY_SPEED / 200,0.05,1)

	TweenService:Create(
		speedFill,
		TweenInfo.new(0.15),
		{
			Size = UDim2.new(percent,0,1,0)
		}
	):Play()

end)

plus.Activated:Connect(function()

	FLY_SPEED = math.min(200,FLY_SPEED + 10)

	speedLabel.Text = "FLY SPEED     "..FLY_SPEED

	local percent = math.clamp(FLY_SPEED / 200,0.05,1)

	TweenService:Create(
		speedFill,
		TweenInfo.new(0.15),
		{
			Size = UDim2.new(percent,0,1,0)
		}
	):Play()

end)

