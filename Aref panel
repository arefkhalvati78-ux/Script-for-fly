	Button.ZIndex = 6
	Button.Parent = Content

	local Corner = Instance.new("UICorner")
	Corner.CornerRadius = UDim.new(0, 14)
	Corner.Parent = Button

	local ButtonStroke = Instance.new("UIStroke")
	ButtonStroke.Color = Color3.fromRGB(45, 65, 76)
	ButtonStroke.Thickness = 1
	ButtonStroke.Transparency = 0.25
	ButtonStroke.Parent = Button

	local Icon = Instance.new("TextLabel")
	Icon.BackgroundTransparency = 1
	Icon.Position = UDim2.new(0, 16, 0, 0)
	Icon.Size = UDim2.new(0, 35, 1, 0)
	Icon.Font = Enum.Font.GothamBold
	Icon.Text = icon
	Icon.TextSize = 22
	Icon.TextColor3 = Color3.fromRGB(115, 220, 205)
	Icon.ZIndex = 7
	Icon.Parent = Button

	local Label = Instance.new("TextLabel")
	Label.BackgroundTransparency = 1
	Label.Position = UDim2.new(0, 57, 0, 7)
	Label.Size = UDim2.new(1, -130, 0, 25)
	Label.Font = Enum.Font.GothamBold
	Label.Text = name
	Label.TextColor3 = Color3.fromRGB(235, 240, 245)
	Label.TextSize = 14
	Label.TextXAlignment = Enum.TextXAlignment.Left
	Label.ZIndex = 7
	Label.Parent = Button

	local Status = Instance.new("TextLabel")
	Status.BackgroundTransparency = 1
	Status.Position = UDim2.new(0, 57, 0, 30)
	Status.Size = UDim2.new(1, -130, 0, 18)
	Status.Font = Enum.Font.Gotham
	Status.Text = "OFF"
	Status.TextColor3 = Color3.fromRGB(125, 135, 145)
	Status.TextSize = 10
	Status.TextXAlignment = Enum.TextXAlignment.Left
