			{
				BackgroundColor3 = Color3.fromRGB(29, 42, 52)
			}
		):Play()

		TweenService:Create(
			ButtonStroke,
			TweenInfo.new(0.18),
			{
				Color = Color3.fromRGB(65, 190, 175),
				Transparency = 0
			}
		):Play()
	end)

	Button.MouseLeave:Connect(function()
		TweenService:Create(
			Button,
			TweenInfo.new(0.18),
			{
				BackgroundColor3 = Color3.fromRGB(22, 30, 40)
			}
		):Play()

		TweenService:Create(
			ButtonStroke,
			TweenInfo.new(0.18),
			{
				Color = Color3.fromRGB(45, 65, 76),
				Transparency = 0.25
