--========================================================--
-- STATUS FUNCTION
--========================================================--

local function setStatus(statusLabel, indicator, enabled)
	if enabled then
		statusLabel.Text = "ON"
		statusLabel.TextColor3 = Color3.fromRGB(80, 220, 190)

		TweenService:Create(
			indicator,
			TweenInfo.new(0.2),
			{
				BackgroundColor3 = Color3.fromRGB(80, 230, 190)
			}
		):Play()
	else
		statusLabel.Text = "OFF"
		statusLabel.TextColor3 = Color3.fromRGB(125, 135, 145)

		TweenService:Create(
			indicator,
			TweenInfo.new(0.2),
			{
				BackgroundColor3 = Color3.fromRGB(90, 100, 110)
			}
		):Play()
	end
end

--========================================================--
-- FLY
--========================================================--

local FlyVelocity
local FlyGyro

local function stopFly()
	if FlyVelocity then
		FlyVelocity:Destroy()
		FlyVelocity = nil
	end

	if FlyGyro then
		FlyGyro:Destroy()
		FlyGyro = nil
	end

	if Humanoid then
		Humanoid.PlatformStand = false
	end
end

local function startFly()
	if not Character or not Root or not Humanoid then
		return
	end

	stopFly()

	FlyVelocity = Instance.new("BodyVelocity")
	FlyVelocity.MaxForce = Vector3.new(100000, 100000, 100000)
	FlyVelocity.Velocity = Vector3.zero
	FlyVelocity.Parent = Root

	FlyGyro = Instance.new("BodyGyro")
	FlyGyro.MaxTorque = Vector3.new(100000, 100000, 100000)
	FlyGyro.P = 10000
	FlyGyro.CFrame = workspace.CurrentCamera.CFrame
	FlyGyro.Parent = Root

	Humanoid.PlatformStand = true
end

FlyButton.MouseButton1Click:Connect(function()
	FlyEnabled = not FlyEnabled

	if FlyEnabled then
		startFly()
	else
		stopFly()
	end

	setStatus(FlyStatus, FlyIndicator, FlyEnabled)
end)

